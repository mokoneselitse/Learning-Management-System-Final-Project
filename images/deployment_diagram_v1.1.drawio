es into»" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=10;endSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="exe" target="subs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gh" value="&lt;i&gt;«device»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;GitHub (cloud)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:10px;font-weight:normal&#x27;&gt;used only by the developer&lt;/span&gt;" style="shape=cube;size=12;direction=south;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="40" width="300" height="290" as="geometry"/></mxCell><mxCell id="gha" value="&lt;i&gt;«execution environment»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:10px;font-weight:normal&#x27;&gt;CI: build, tests, coverage on every push&lt;/span&gt;" style="shape=cube;size=10;direction=south;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fillColor=#FAFAFA;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="260" height="62" as="geometry"/></mxCell><mxCell id="rel" value="&lt;i&gt;«artifact»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;LMS-1.1.0-windows.zip&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;release v1.1 (tag v1.1)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1050" y="200" width="240" height="60" as="geometry"/></mxCell><mxCell id="p1" value="install / upgrade only&lt;br/&gt;(download once,&lt;br/&gt;or copy by USB)" style="html=1;endArrow=none;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gh" target="pc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dev" value="&lt;i&gt;«device»&lt;/i&gt;&lt;br/&gt;&lt;b&gt