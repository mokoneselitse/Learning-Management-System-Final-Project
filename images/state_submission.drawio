        <mxCell id="c22" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;labelBackgroundColor=none;strokeColor=#000000;" value="Any event not shown for the current state is rejected with InvalidTransitionError.&lt;br&gt;Student visibility: feedback from Marked onwards (FR09, C1); mark only in Released (FR13).&lt;br&gt;There is deliberately no Marked → Released transition, so no mark reaches a student without HoD moderation (C1).&lt;br&gt;A Late submission can never return to Submitted, so resubmission after the deadline is impossible (FR17, O2)." vertex="1">
          <mxGeometry height="86" width="760" x="820" y="560" as="geometry" />
        </mxCell>
